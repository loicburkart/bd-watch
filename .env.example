# Copy to .env and fill in. .env is git-ignored.

# LLM backend. Priority: Databricks (if all 3 set) -> Anthropic -> mock fallback.

# Option A — Databricks serving endpoint (OpenAI-compatible)
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_ENDPOINT=databricks-claude-haiku-4-5

# Option B — Anthropic API
ANTHROPIC_API_KEY=
BD_WATCH_MODEL=claude-sonnet-4-6

# CRM (step 01) — placeholder, adapt to the team's CRM
CRM_API_BASE=
CRM_API_KEY=

# Activation feeder: path to the CRM deal export (.csv or .xlsx).
# Defaults to data/samples/crm_deals_sample.csv when unset.
CRM_EXPORT_PATH=

# News / press sources (step 01) — placeholder
NEWS_API_KEY=
